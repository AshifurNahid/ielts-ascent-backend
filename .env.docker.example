# Copy this file to .env for local Docker infra
POSTGRES_PORT=5432
POSTGRES_DB=ielts_ascent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PORT=6379

# Spring local app env values (match docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/ielts_ascent
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379

# First-time bootstrap: disable Flyway, let Hibernate create/update tables
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

